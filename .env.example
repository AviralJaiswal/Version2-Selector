# Voice mode (self-hosted, free - no API key needed)
VOICE_ENABLED=true
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
INDIC_TTS_ENABLED=true
INDIC_TTS_TIMEOUT_SECONDS=6.0
