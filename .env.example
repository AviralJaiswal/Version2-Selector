DB_URL=sqlite:///./qcom.db
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
CHROMA_PATH=./chroma_data
CHROMA_ENABLED=true
MAPBOX_TOKEN=
